# Banco e fila (no docker-compose já vêm preenchidos)
DATABASE_URL=postgresql://posterai:posterai@localhost:5432/posterai
REDIS_URL=redis://localhost:6379
# Relativo a apps/web e apps/worker (ambos no mesmo nível). Em produção: /storage
STORAGE_DIR=../../storage

# Login simples por senha única
APP_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-com-openssl-rand-hex-32

# IA: por enquanto só a OpenAI (texto dos carrosséis + transcrição Whisper nas Fase 2)
OPENAI_API_KEY=
LLM_PROVIDER=openai        # openai | anthropic | mock (mock = texto de exemplo, sem chave)
OPENAI_MODEL=gpt-4o-mini
# Opcional, caso queira testar a Anthropic para o texto
ANTHROPIC_API_KEY=

# Para `docker compose` local (no Coolify estas três são geradas automaticamente)
SERVICE_PASSWORD_APP=troque-esta-senha
SERVICE_PASSWORD_64_SESSION=gere-com-openssl-rand-hex-32
SERVICE_PASSWORD_POSTGRES=posterai
